# TruthTrace content-agnostic forensic configuration
DEEPFAKE_MODEL=buildborderless/CommunityForensics-DeepfakeDet-ViT
SECOND_DETECTOR_MODEL=delpot/steganograph-ia-detector
ENABLE_SECOND_DETECTOR=true
NPR_WEIGHTS_REPO=siddharthksah/deepsafe-weights
NPR_WEIGHTS_FILE=npr_deepfakedetection/NPR.pth
FORENSIC_VIEWS=5
DINO_MODEL=facebook/dinov2-base
CLIP_MODEL=openai/clip-vit-base-patch32

# Optional trained audio detector (HF audio-classification model). Default is Apache-2.0 Hemgg/Deepfake-audio-detection.
TRUTHTRACE_AUDIO_MODEL=Hemgg/Deepfake-audio-detection

# Optional Gemini reasoning layer
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
